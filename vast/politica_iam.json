{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::chatterbox-lora-pesos-866923470465"
    },
    {
      "Sid": "LeerEscribirObjetos",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::chatterbox-lora-pesos-866923470465/*"
    }
  ]
}
