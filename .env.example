# Copia este archivo a .env y pon tus claves (.env NO se sube a git)
ELEVENLABS_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=

# --- Despliegue con Docker (docker-compose.yml) ---
# Claves de un usuario IAM con permiso de LECTURA sobre el bucket de pesos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
PESOS_BUCKET=chatterbox-lora-pesos-866923470465
# Adaptadores a bajar al arrancar (carpetas lora_out* del bucket)
MODELOS_LORA=lora_out_2voces lora_out_2000
# Opcional: protege la API si la expones en red
TTS_API_KEY=

# --- ngrok: exponer la API y el Streamlit a internet (python iniciar_ngrok.py) ---
NGROK_AUTHTOKEN=
# Usuario/contraseña que pide ngrok para abrir el Streamlit
NGROK_UI_USER=tts
NGROK_UI_PASS=
